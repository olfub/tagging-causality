{
	"name": "tagging_causality",
	"build": {
		"dockerfile": "../.docker/Dockerfile",
		"context": ".."
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"github.copilot",
				"ms-python.isort",
				"ms-python.black-formatter",
				"mechatroner.rainbow-csv"
			]
		},
		"settings": {
			"terminal.integrated.defaultProfile.linux": "zsh"
		}
	},
	"runArgs": [
		"--device",
		"nvidia.com/gpu=all",
		"--shm-size=20g"
		// "--cpus",
		// "100"
	]
}